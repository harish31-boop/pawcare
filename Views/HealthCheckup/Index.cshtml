@{
    ViewData["Title"] = "Health Checkup";
}

<style>
    .page-box {
        max-width: 800px;
        margin: 40px auto;
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
    }

    .page-title {
        text-align: center;
        color: #1976d2;
        margin-bottom: 25px;
    }

    .info-card {
        background: #f5f9ff;
        padding: 20px;
        margin: 15px 0;
        border-radius: 15px;
    }

    .info-card h3 {
        color: #1976d2;
    }

    .book-btn {
        display: block;
        text-align: center;
        background: #1976d2;
        color: white;
        padding: 14px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: bold;
        margin-top: 25px;
    }

    .book-btn:hover {
        background: #125ca8;
        color: white;
    }
</style>

<div class="page-box">

    <h1 class="page-title">
        🩺 Pet Health Checkup
    </h1>

    <p>
        Regular health checkups help keep your pet healthy,
        active and happy.
    </p>

    <div class="info-card">
        <h3>🔍 General Health Examination</h3>
        <p>
            Our veterinary team checks your pet's overall
            health, weight, temperature and physical condition.
        </p>
    </div>

    <div class="info-card">
        <h3>❤️ Vital Health Check</h3>
        <p>
            Heart rate, breathing, eyes, ears, teeth and
            other important health conditions are checked.
        </p>
    </div>

    <div class="info-card">
        <h3>🐶 Preventive Care</h3>
        <p>
            Regular checkups can help identify health
            problems early and support preventive care.
        </p>
    </div>

    <a href="/Appointment" class="book-btn">
        📅 Book Health Checkup Appointment
    </a>

</div>