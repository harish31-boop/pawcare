@{
    ViewData["Title"] = "Pet Medicines";
}

<style>
    .topic-box {
        max-width: 800px;
        margin: 40px auto;
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
    }

    .topic-title {
        text-align: center;
        color: #1976d2;
        margin-bottom: 30px;
    }

    .topic-card {
        background: #f3f8ff;
        padding: 20px;
        margin: 15px 0;
        border-radius: 15px;
    }

    .topic-card h3 {
        color: #1976d2;
    }

    .book-btn {
        display: block;
        text-align: center;
        background: #1976d2;
        color: white;
        padding: 14px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: bold;
        margin-top: 25px;
    }
</style>

<div class="topic-box">

    <h1 class="topic-title">💊 Pet Medicines</h1>

    <p>
        Learn about basic pet healthcare products and
        the importance of using medicines responsibly.
    </p>

    <div class="topic-card">
        <h3>💊 Medicines</h3>
        <p>
            Medicines may be prescribed by a veterinarian
            based on your pet's condition.
        </p>
    </div>

    <div class="topic-card">
        <h3>🧴 Health Care Products</h3>
        <p>
            Pet-care products can support hygiene and
            general wellbeing.
        </p>
    </div>

    <div class="topic-card">
        <h3>⚠️ Important Safety</h3>
        <p>
            Always follow veterinary advice and never give
            human medicines to pets without professional guidance.
        </p>
    </div>

    <a href="/Appointment" class="book-btn">
        📅 Book Veterinary Appointment
    </a>

</div>