@{
    ViewData["Title"] = "Emergency Care";
}

<style>
    .topic-box {
        max-width: 800px;
        margin: 40px auto;
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
    }

    .topic-title {
        text-align: center;
        color: #d32f2f;
        margin-bottom: 30px;
    }

    .topic-card {
        background: #fff5f5;
        padding: 20px;
        margin: 15px 0;
        border-radius: 15px;
    }

    .topic-card h3 {
        color: #d32f2f;
    }

    .book-btn {
        display: block;
        text-align: center;
        background: #d32f2f;
        color: white;
        padding: 14px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: bold;
        margin-top: 25px;
    }
</style>

<div class="topic-box">

    <h1 class="topic-title">🚨 Emergency Care</h1>

    <p>
        Emergency situations require quick professional
        veterinary attention.
    </p>

    <div class="topic-card">
        <h3>🚨 Emergency Symptoms</h3>
        <p>
            Serious injury, difficulty breathing, severe bleeding,
            unconsciousness or sudden severe illness may require
            immediate veterinary attention.
        </p>
    </div>

    <div class="topic-card">
        <h3>🏥 Immediate Veterinary Care</h3>
        <p>
            Contact a veterinarian or nearby veterinary hospital
            as soon as possible during an emergency.
        </p>
    </div>

    <div class="topic-card">
        <h3>🐾 Stay Calm</h3>
        <p>
            Keep your pet safe and calm while arranging
            professional veterinary assistance.
        </p>
    </div>

    <a href="/Appointment" class="book-btn">
        📅 Contact / Book Appointment
    </a>

</div>