@{
    ViewData["Title"] = "Health Checkup";
}

<style>
    .topic-box {
        max-width: 800px;
        margin: 40px auto;
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
    }

    .topic-title {
        text-align: center;
        color: #1976d2;
        margin-bottom: 30px;
    }

    .topic-card {
        background: #f3f8ff;
        padding: 20px;
        margin: 15px 0;
        border-radius: 15px;
    }

    .topic-card h3 {
        color: #1976d2;
    }

    .book-btn {
        display: block;
        text-align: center;
        background: #1976d2;
        color: white;
        padding: 14px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: bold;
        margin-top: 25px;
    }
</style>

<div class="topic-box">

    <h1 class="topic-title">🩺 Pet Health Checkup</h1>

    <p>
        Regular health checkups help identify health problems
        early and keep your pet healthy and active.
    </p>

    <div class="topic-card">
        <h3>🔍 General Examination</h3>
        <p>
            Complete physical examination including weight,
            temperature and overall condition.
        </p>
    </div>

    <div class="topic-card">
        <h3>❤️ Vital Signs</h3>
        <p>
            Heart rate, breathing, eyes, ears and other
            important health conditions are checked.
        </p>
    </div>

    <div class="topic-card">
        <h3>🐶 Preventive Care</h3>
        <p>
            Regular checkups help prevent health problems
            and support your pet's wellbeing.
        </p>
    </div>

    <a href="/Appointment" class="book-btn">
        📅 Book Health Checkup Appointment
    </a>

</div>